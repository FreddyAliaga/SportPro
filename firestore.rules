rules_version = '2';

// Reglas de seguridad de Cloud Firestore – SportPro
// US-001 (registro con código de invitación e inicio de sesión)
// US-002 (academia, equipos, usuarios e invitaciones de DT por el ADM).
// US-003 (plantel y perfil del jugador, códigos JUG/PAD). Se amplían en US-016.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function invitationAfter(code) {
      return getAfter(/databases/$(database)/documents/invitations/$(code)).data;
    }

    // ---------- US-002 ----------

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function academyPath(academyId) {
      return /databases/$(database)/documents/academies/$(academyId);
    }

    function teamPath(academyId, teamId) {
      return /databases/$(database)/documents/academies/$(academyId)/teams/$(teamId);
    }

    // Perfil de quien hace la petición
    function myProfile() {
      return get(userPath(request.auth.uid)).data;
    }

    // Miembro activo de la academia (ADM, DT, JUG o PAD)
    function isMemberOf(academyId) {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && myProfile().academyId == academyId
        && myProfile().status == 'active';
    }

    // Administrador activo de ESA academia
    function isAdmOf(academyId) {
      return isMemberOf(academyId) && myProfile().role == 'ADM';
    }

    // Datos válidos de una academia (logo: 150 KB en Base64 = 204800 caracteres como máximo)
    function validAcademy(data) {
      return data.name is string && data.name.size() >= 3 && data.name.size() <= 80
        && data.city is string && data.city.size() > 0 && data.city.size() <= 60
        && data.institutionalEmail is string && data.institutionalEmail.size() <= 100
        && data.logoBase64 is string && data.logoBase64.size() <= 204800
        // RN-008: plazos de convocatoria
        && data.callupNoticeHours is int && data.callupNoticeHours >= 1 && data.callupNoticeHours <= 168
        && data.callupConfirmHours is int && data.callupConfirmHours >= 0
        && data.callupConfirmHours < data.callupNoticeHours;
    }

    // Datos válidos de un equipo (RN-004: categoría de la lista)
    function validTeam(data) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 40
        && data.category in ['Sub-8', 'Sub-10', 'Sub-12', 'Sub-15', 'Sub-17', 'Primera', 'Otra']
        && data.maxStarters is int && data.maxStarters >= 1 && data.maxStarters <= 11
        && data.maxSubstitutes is int && data.maxSubstitutes >= 0 && data.maxSubstitutes <= 20
        && data.active is bool;
    }

    // Un campo que no cambia en la actualización
    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    // ---------- US-003 ----------

    function playerPath(playerId) {
      return /databases/$(database)/documents/players/$(playerId);
    }

    function privatePath(playerId) {
      return /databases/$(database)/documents/players/$(playerId)/private/data;
    }

    function invitationPath(code) {
      return /databases/$(database)/documents/invitations/$(code);
    }

    // DT activo de ESE equipo (el DT es el usuario con role "DT" y teamId del equipo)
    function isDtOfTeam(academyId, teamId) {
      return isMemberOf(academyId) && myProfile().role == 'DT' && myProfile().teamId == teamId;
    }

    // Gestiona al jugador: el ADM de su academia o el DT de su equipo
    function canManage(player) {
      return isAdmOf(player.academyId) || isDtOfTeam(player.academyId, player.teamId);
    }

    // Su apoderado o el propio jugador mayor de edad (con cuenta ACTIVA)
    function isFamily(player) {
      return signedIn()
        && (request.auth.uid in player.guardianIds
            || (player.userId != '' && player.userId == request.auth.uid))
        && exists(userPath(request.auth.uid))
        && myProfile().status == 'active';
    }

    // Tiene 18 años o más (misma tolerancia de 6573 días que el registro de la US-001)
    function isAdultBirthDate(birthDate) {
      return birthDate <= request.time - duration.value(6573, 'd');
    }

    // Datos deportivos válidos
    function validPlayer(data) {
      return data.name is string && data.name.size() >= 3 && data.name.size() <= 60
        && data.category in ['Sub-8', 'Sub-10', 'Sub-12', 'Sub-15', 'Sub-17', 'Primera', 'Otra']
        && data.positionMain in ['Portero', 'Defensa central', 'Lateral', 'Mediocampista defensivo', 'Mediocampista', 'Mediocampista ofensivo', 'Extremo', 'Delantero']
        && data.positionSecondary in ['', 'Portero', 'Defensa central', 'Lateral', 'Mediocampista defensivo', 'Mediocampista', 'Mediocampista ofensivo', 'Extremo', 'Delantero']
        && (data.dorsal == null || (data.dorsal is int && data.dorsal >= 1 && data.dorsal <= 99))
        && data.foot in ['Derecho', 'Izquierdo', 'Ambos']
        && data.isMinor is bool
        && data.active is bool
        && data.hasEmergencyContact is bool
        && data.userId is string
        && data.guardianIds is list;
    }

    // Un jugador no puede quedar como "mayor de edad" si su fecha de nacimiento dice que es menor
    function minorFlagOk(player, privateData) {
      return player.isMinor == true || isAdultBirthDate(privateData.birthDate);
    }

    // Datos privados válidos (foto: 150 KB en Base64 = 204800 caracteres como máximo; RN-014)
    function validPrivate(data) {
      return data.birthDate is timestamp && data.birthDate < request.time
        && data.contactPhone is string && (data.contactPhone == '' || data.contactPhone.matches('^9[0-9]{8}$'))
        && data.emergencyName is string && data.emergencyName.size() <= 60
        && data.emergencyRelation is string && data.emergencyRelation.size() <= 30
        && data.emergencyPhone is string && (data.emergencyPhone == '' || data.emergencyPhone.matches('^9[0-9]{8}$'))
        && data.photoBase64 is string && data.photoBase64.size() <= 204800
        && (data.heightCm == null || (data.heightCm is int && data.heightCm >= 100 && data.heightCm <= 220))
        && (data.weightKg == null || (data.weightKg is int && data.weightKg >= 20 && data.weightKg <= 150));
    }

    // RN-005: contacto de emergencia completo (nombre, parentesco y celular)
    function emergencyComplete(data) {
      return data.emergencyName.size() > 0 && data.emergencyRelation.size() > 0 && data.emergencyPhone.size() > 0;
    }

    // El código se gastó EN ESTA MISMA operación, por quien hace la petición, con ese rol y para ese jugador
    // (antes no estaba usado y después sí: un código viejo ya usado no sirve para volver a vincularse)
    function invitationUsedNow(code, role, playerId) {
      return get(invitationPath(code)).data.get('used', false) == false
        && getAfter(invitationPath(code)).data.usedBy == request.auth.uid
        && getAfter(invitationPath(code)).data.role == role
        && getAfter(invitationPath(code)).data.playerId == playerId;
    }

    // Código JUG/PAD válido para un jugador (lo crea el DT de su equipo o el ADM de su academia)
    function validPlayerInvitation(data, playerId) {
      return canManage(get(playerPath(playerId)).data)
        && get(playerPath(playerId)).data.active == true
        && get(playerPath(playerId)).data.userId == ''
        && data.academyId == get(playerPath(playerId)).data.academyId
        && data.teamId == get(playerPath(playerId)).data.teamId
        // PRIVACIDAD: nombre corto ("Mateo R."): cualquiera con el código lo puede leer
        && data.playerName is string && data.playerName.size() > 0 && data.playerName.size() <= 30
        && data.invitedByName is string && data.invitedByName.size() > 0 && data.invitedByName.size() <= 80
        // Lo que ve quien se registra debe coincidir con la academia y el equipo reales
        && data.academyName == get(academyPath(data.academyId)).data.name
        && data.city == get(academyPath(data.academyId)).data.city
        && data.teamName == get(teamPath(data.academyId, data.teamId)).data.name
        && get(teamPath(data.academyId, data.teamId)).data.active == true
        // PAD: solo para un menor. JUG: solo si ya tiene 18 años según su fecha de nacimiento real.
        && ((data.role == 'PAD' && get(playerPath(playerId)).data.isMinor == true)
            || (data.role == 'JUG' && isAdultBirthDate(get(privatePath(playerId)).data.birthDate)));
    }

    // Códigos de invitación: el ID del documento es el código.
    match /invitations/{code} {
      // Se puede consultar UN código conocido (para validarlo), pero no listar todos.
      allow get: if true;

      // US-002: el ADM lista los códigos de SU academia (consulta con where academyId == ...)
      allow list: if signedIn() && isAdmOf(resource.data.academyId);

      // US-003: el DT lista los códigos JUG/PAD de SU equipo
      // (consulta con where academyId == ..., teamId == ... y role in ['JUG', 'PAD'])
      allow list: if signedIn()
        && resource.data.role in ['JUG', 'PAD']
        && isDtOfTeam(resource.data.academyId, resource.data.teamId);

      // US-001: solo se puede marcar como usado una vez, por la persona que se registra,
      // si no venció ni fue anulado, y cambiando únicamente used / usedBy / usedAt.
      allow update: if signedIn()
        && resource.data.get('used', false) == false
        && resource.data.get('status', 'PENDIENTE') != 'ANULADO'
        && (!('expiresAt' in resource.data) || request.time < resource.data.expiresAt)
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'usedAt'])
        // el código solo se gasta en la misma transacción que crea el perfil
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
        // quien ya tiene perfil no puede gastar otro código
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid));

      // US-002 (RN-002): el ADM anula un código de su academia que aún no se usó.
      // Anular = status "ANULADO"; no se cambia nada más y el código no se borra.
      allow update: if signedIn()
        && isAdmOf(resource.data.academyId)
        && resource.data.get('used', false) == false
        && request.resource.data.status == 'ANULADO'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      // US-002: al renombrar la academia, el ADM actualiza el nombre en sus códigos sin usar
      // (solo academyName e invitedByName, y solo con el nombre nuevo de la academia,
      // en la misma operación). invitedByName solo puede quedar como "la administración de <nombre nuevo>".
      allow update: if signedIn()
        && isAdmOf(resource.data.academyId)
        && resource.data.get('used', false) == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['academyName', 'invitedByName'])
        && request.resource.data.academyName == getAfter(academyPath(resource.data.academyId)).data.name
        && (unchanged('invitedByName')
            || request.resource.data.invitedByName == 'la administración de ' + getAfter(academyPath(resource.data.academyId)).data.name);

      // US-002: el ADM crea códigos de DT para un equipo ACTIVO de su academia (vencen en 7 días).
      // Los códigos de apoderado los crea el DT en la US-003.
      allow create: if signedIn()
        && isAdmOf(request.resource.data.academyId)
        // Formato PREFIJO-XXXXXX: 4 letras del nombre + 6 caracteres sin confusiones
        && code.matches('^[A-Z]{4}-[A-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['academyId', 'academyName', 'city', 'role', 'teamId', 'teamName', 'invitedByName', 'playerId', 'playerName', 'used', 'status', 'createdAt', 'expiresAt', 'createdBy'])
        && request.resource.data.role == 'DT'
        && request.resource.data.used == false
        && request.resource.data.status == 'PENDIENTE'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.playerId == ''
        && request.resource.data.playerName == ''
        // Lo que ve quien se registra debe coincidir con la academia y el equipo reales
        && request.resource.data.academyName == get(academyPath(request.resource.data.academyId)).data.name
        && request.resource.data.city == get(academyPath(request.resource.data.academyId)).data.city
        && request.resource.data.teamName == get(teamPath(request.resource.data.academyId, request.resource.data.teamId)).data.name
        && get(teamPath(request.resource.data.academyId, request.resource.data.teamId)).data.active == true
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(8, 'd');

      // US-003 (RN-002, RN-003): el DT (para jugadores de su equipo) o el ADM (para cualquiera de
      // su academia) crea un código PAD para el apoderado de un menor o un código JUG para un
      // jugador que ya tiene 18 años. Vencen en 7 días.
      allow create: if signedIn()
        && code.matches('^[A-Z]{4}-[A-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['academyId', 'academyName', 'city', 'role', 'teamId', 'teamName', 'invitedByName', 'playerId', 'playerName', 'used', 'status', 'createdAt', 'expiresAt', 'createdBy'])
        && request.resource.data.role in ['JUG', 'PAD']
        && request.resource.data.used == false
        && request.resource.data.status == 'PENDIENTE'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.playerId is string
        && request.resource.data.playerId != ''
        && validPlayerInvitation(request.resource.data, request.resource.data.playerId)
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(8, 'd');

      // US-003: el DT anula un código JUG/PAD de su equipo que aún no se usó (el ADM ya puede, arriba)
      allow update: if signedIn()
        && resource.data.role in ['JUG', 'PAD']
        && isDtOfTeam(resource.data.academyId, resource.data.teamId)
        && resource.data.get('used', false) == false
        && request.resource.data.status == 'ANULADO'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      // US-003: "Vincular otro jugador". Un apoderado que YA tiene cuenta usa un nuevo código PAD
      // de SU academia. Solo en la misma operación que lo agrega como apoderado de ese jugador.
      // (La regla de la US-001 de arriba sigue exigiendo que quien se registra no tenga perfil.)
      allow update: if signedIn()
        && resource.data.role == 'PAD'
        && resource.data.get('used', false) == false
        && resource.data.get('status', 'PENDIENTE') != 'ANULADO'
        && (!('expiresAt' in resource.data) || request.time < resource.data.expiresAt)
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'usedAt'])
        && isMemberOf(resource.data.academyId)
        && myProfile().role == 'PAD'
        && request.auth.uid in getAfter(playerPath(resource.data.playerId)).data.guardianIds
        && getAfter(playerPath(resource.data.playerId)).data.lastInvitationCode == code;

      // Nunca se borran
      allow delete: if false;
    }

    // Perfil de cada usuario (solo personas de 18 años o más tienen cuenta)
    match /users/{uid} {
      // Cada persona lee su perfil; el ADM lee los perfiles de su academia (US-002)
      allow read: if signedIn()
        && (request.auth.uid == uid || isAdmOf(resource.data.academyId));

      // US-001: se crea en la misma transacción que marca el código como usado:
      // el rol y la academia deben coincidir con los del código y debe aceptar los términos de uso.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'phoneNumber', 'birthDate', 'invitationCode', 'role', 'academyId', 'academyName', 'teamId', 'playerId', 'status', 'termsAccepted', 'createdAt'])
        && request.resource.data.status == 'pending_verification'
        && request.resource.data.termsAccepted.version is string
        // RN-003: solo mayores de 18 años.
        // La app valida la edad exacta (años cumplidos); esta regla es una segunda barrera.
        // Se usa 6573 días por dos motivos:
        //  - 18 años son 6574 o 6575 días según cuántos años bisiestos haya de por medio.
        //  - La app guarda la fecha a las 12:00 (mediodía) UTC, así que el día del cumpleaños
        //    en Lima (UTC-5) aún no se completan los días antes de las 7:00 a. m.
        // Con 6573 nunca se rechaza a quien cumple 18 hoy (a lo mucho deja pasar 1-2 días antes).
        && request.resource.data.birthDate is timestamp
        && request.resource.data.birthDate <= request.time - duration.value(6573, 'd')
        && invitationAfter(request.resource.data.invitationCode).usedBy == request.auth.uid
        && request.resource.data.role == invitationAfter(request.resource.data.invitationCode).role
        && request.resource.data.academyId == invitationAfter(request.resource.data.invitationCode).academyId
        && request.resource.data.teamId == invitationAfter(request.resource.data.invitationCode).get('teamId', '')
        && request.resource.data.playerId == invitationAfter(request.resource.data.invitationCode).get('playerId', '');

      // US-002: "Registrar mi academia". El perfil ADM se crea SIN código, en la misma
      // transacción que crea su academia (nueva) con adminUid = su uid.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'phoneNumber', 'birthDate', 'invitationCode', 'role', 'academyId', 'academyName', 'teamId', 'playerId', 'status', 'termsAccepted', 'createdAt'])
        && request.resource.data.status == 'pending_verification'
        && request.resource.data.termsAccepted.version is string
        // RN-003: misma regla de edad que arriba
        && request.resource.data.birthDate is timestamp
        && request.resource.data.birthDate <= request.time - duration.value(6573, 'd')
        && request.resource.data.role == 'ADM'
        && request.resource.data.invitationCode == ''
        && request.resource.data.teamId == ''
        && request.resource.data.playerId == ''
        && request.resource.data.academyId is string
        // la academia es nueva (no existía) y queda creada en esta misma operación, a su nombre
        && !exists(academyPath(request.resource.data.academyId))
        && existsAfter(academyPath(request.resource.data.academyId))
        && getAfter(academyPath(request.resource.data.academyId)).data.adminUid == request.auth.uid
        && request.resource.data.academyName == getAfter(academyPath(request.resource.data.academyId)).data.name;

      // US-001: tras verificar el correo, la cuenta pasa de "pending_verification" a "active".
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && resource.data.status == 'pending_verification'
        && request.resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      // US-002: el ADM actualiza perfiles de SU academia, solo estos campos:
      //  - status: active <-> inactive (desactivar/reactivar), nunca el suyo
      //    ni el de cuentas bloqueadas o sin verificar
      //  - teamId: el DT de un equipo ("" = sin equipo, o un equipo de la academia);
      //    al desactivar a un DT o su equipo, queda en ""
      //  - academyName: la copia del nombre cuando se renombra la academia
      allow update: if signedIn()
        && isAdmOf(resource.data.academyId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'teamId', 'academyName'])
        && (unchanged('status') || (
              request.auth.uid != uid
              && resource.data.status in ['active', 'inactive']
              && request.resource.data.status in ['active', 'inactive']))
        && (unchanged('teamId') || (
              resource.data.role == 'DT'
              && (request.resource.data.teamId == ''
                  || existsAfter(/databases/$(database)/documents/academies/$(resource.data.academyId)/teams/$(request.resource.data.teamId)))))
        && (unchanged('academyName')
              || request.resource.data.academyName == getAfter(academyPath(resource.data.academyId)).data.name);

      // Nunca se borran (desactivar = status "inactive")
      allow delete: if false;
    }

    // US-002: academias
    match /academies/{academyId} {
      // La leen los miembros activos de la academia
      allow read: if isMemberOf(academyId);

      // Solo se crea en el registro del ADM, en la misma transacción que su perfil.
      // "verified" empieza en false y solo se cambia desde la consola (RN-018).
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'city', 'institutionalEmail', 'logoBase64', 'callupNoticeHours', 'callupConfirmHours', 'verified', 'adminUid', 'createdAt'])
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.verified == false
        && validAcademy(request.resource.data)
        // quien ya tiene perfil no puede crear otra academia: una cuenta = una academia
        && !exists(userPath(request.auth.uid))
        && getAfter(userPath(request.auth.uid)).data.role == 'ADM'
        && getAfter(userPath(request.auth.uid)).data.academyId == academyId;

      // El ADM edita los datos, sin tocar verified ni adminUid
      allow update: if isAdmOf(academyId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'city', 'institutionalEmail', 'logoBase64', 'callupNoticeHours', 'callupConfirmHours'])
        && validAcademy(request.resource.data);

      allow delete: if false;

      // Equipos de la academia (el DT NO se guarda aquí: es el usuario DT con ese teamId)
      match /teams/{teamId} {
        allow read: if isMemberOf(academyId);

        allow create: if isAdmOf(academyId)
          && request.resource.data.keys().hasOnly(['name', 'category', 'maxStarters', 'maxSubstitutes', 'active', 'createdAt'])
          && request.resource.data.active == true
          && validTeam(request.resource.data);

        // Editar o desactivar (active = false); nunca se borra
        allow update: if isAdmOf(academyId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'category', 'maxStarters', 'maxSubstitutes', 'active'])
          && validTeam(request.resource.data);

        allow delete: if false;
      }
    }

    // US-003: jugadores (datos deportivos). Nunca se borran: retirar = active false (RN-004).
    // Los leen el ADM de la academia, el DT activo de su equipo, sus apoderados y el propio jugador.
    match /players/{playerId} {
      allow read: if canManage(resource.data) || isFamily(resource.data);

      // "Nuevo jugador": DT de un equipo ACTIVO o ADM de la academia, en la misma operación
      // que sus datos privados (fecha de nacimiento). Empieza sin cuenta y sin apoderados.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['academyId', 'teamId', 'name', 'category', 'positionMain', 'positionSecondary', 'dorsal', 'foot', 'isMinor', 'userId', 'guardianIds', 'hasEmergencyContact', 'active', 'lastInvitationCode', 'createdAt', 'createdBy'])
        && canManage(request.resource.data)
        && validPlayer(request.resource.data)
        && request.resource.data.userId == ''
        && request.resource.data.guardianIds.size() == 0
        && request.resource.data.hasEmergencyContact == false
        && request.resource.data.active == true
        && request.resource.data.lastInvitationCode == ''
        && request.resource.data.createdBy == request.auth.uid
        && get(teamPath(request.resource.data.academyId, request.resource.data.teamId)).data.active == true
        && existsAfter(privatePath(playerId))
        && minorFlagOk(request.resource.data, getAfter(privatePath(playerId)).data);

      // DT de su equipo o ADM: datos deportivos, si es menor (con la fecha de nacimiento),
      // traslado (solo a otro equipo ACTIVO de la MISMA academia) y retirar/reactivar.
      allow update: if canManage(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'category', 'positionMain', 'positionSecondary', 'dorsal', 'foot', 'isMinor', 'teamId', 'active'])
        && validPlayer(request.resource.data)
        && (unchanged('teamId')
            || get(teamPath(resource.data.academyId, request.resource.data.teamId)).data.active == true)
        && (unchanged('isMinor') || minorFlagOk(request.resource.data, getAfter(privatePath(playerId)).data))
        // un jugador con cuenta propia no puede volver a ser menor de edad
        && (resource.data.userId == '' || request.resource.data.isMinor == false)
        // solo se reactiva si su equipo está activo (si no, primero se traslada)
        && (unchanged('active') || request.resource.data.active == false
            || get(teamPath(resource.data.academyId, request.resource.data.teamId)).data.active == true);

      // Apoderado o jugador mayor: solo hasEmergencyContact, y debe coincidir con sus datos privados
      allow update: if isFamily(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hasEmergencyContact'])
        && request.resource.data.hasEmergencyContact == emergencyComplete(getAfter(privatePath(playerId)).data);

      // Uso de un código PAD (registro US-001 o "Vincular otro jugador"): se agrega a sí mismo
      // como apoderado, en la misma operación que gasta el código para ESTE jugador.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guardianIds', 'lastInvitationCode'])
        && request.resource.data.guardianIds.toSet() == resource.data.guardianIds.toSet().union([request.auth.uid].toSet())
        && invitationUsedNow(request.resource.data.lastInvitationCode, 'PAD', playerId);

      // Uso de un código JUG (registro US-001): el jugador mayor asume su cuenta y su gestión;
      // se retira el vínculo con sus apoderados.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId', 'guardianIds', 'isMinor', 'lastInvitationCode'])
        && resource.data.userId == ''
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.guardianIds.size() == 0
        && request.resource.data.isMinor == false
        && invitationUsedNow(request.resource.data.lastInvitationCode, 'JUG', playerId)
        // la fecha de nacimiento de la cuenta nueva debe ser la del perfil del jugador
        && getAfter(userPath(request.auth.uid)).data.birthDate == get(privatePath(playerId)).data.birthDate;

      allow delete: if false;

      // Datos privados: players/{playerId}/private/data (RN-005, RN-014)
      match /private/{docId} {
        allow read: if docId == 'data'
          && (canManage(get(playerPath(playerId)).data) || isFamily(get(playerPath(playerId)).data));

        // Se crea junto con el jugador ("Nuevo jugador")
        allow create: if docId == 'data'
          && request.resource.data.keys().hasOnly(['birthDate', 'contactPhone', 'emergencyName', 'emergencyRelation', 'emergencyPhone', 'photoBase64', 'heightCm', 'weightKg'])
          && !exists(playerPath(playerId))
          && existsAfter(playerPath(playerId))
          && canManage(getAfter(playerPath(playerId)).data)
          && validPrivate(request.resource.data);

        // DT de su equipo o ADM: solo la fecha de nacimiento
        // (y "es menor" del jugador debe seguir siendo coherente con la fecha nueva)
        allow update: if docId == 'data'
          && canManage(get(playerPath(playerId)).data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['birthDate'])
          && validPrivate(request.resource.data)
          && minorFlagOk(getAfter(playerPath(playerId)).data, request.resource.data);

        // Apoderado o jugador mayor: contacto, emergencia, foto y datos físicos (nunca la fecha de nacimiento)
        allow update: if docId == 'data'
          && isFamily(get(playerPath(playerId)).data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contactPhone', 'emergencyName', 'emergencyRelation', 'emergencyPhone', 'photoBase64', 'heightCm', 'weightKg'])
          && validPrivate(request.resource.data);

        allow delete: if false;
      }

      // Historial del jugador (RN-004): altas, traslados, retiros y reactivaciones.
      // Lo escribe el DT o el ADM en la misma operación del cambio; nunca se edita ni se borra.
      match /history/{entryId} {
        allow read: if canManage(get(playerPath(playerId)).data);

        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['type', 'fromTeamId', 'fromTeamName', 'toTeamId', 'toTeamName', 'byUid', 'byName', 'at'])
          && request.resource.data.type in ['ALTA', 'TRASLADO', 'RETIRO', 'REACTIVACION']
          && request.resource.data.byUid == request.auth.uid
          && request.resource.data.at == request.time
          // quien gestionaba al jugador ANTES del cambio (en un traslado, el DT del equipo anterior);
          // si el jugador es nuevo, quien lo está creando
          && ((exists(playerPath(playerId)) && canManage(get(playerPath(playerId)).data))
              || (!exists(playerPath(playerId)) && canManage(getAfter(playerPath(playerId)).data)))
          // la entrada debe corresponder al cambio que se hace en esta misma operación
          && ((request.resource.data.type == 'ALTA'
                && !exists(playerPath(playerId)) && existsAfter(playerPath(playerId)))
              || (request.resource.data.type == 'TRASLADO'
                && exists(playerPath(playerId))
                && getAfter(playerPath(playerId)).data.teamId != get(playerPath(playerId)).data.teamId
                && request.resource.data.toTeamId == getAfter(playerPath(playerId)).data.teamId
                && request.resource.data.fromTeamId == get(playerPath(playerId)).data.teamId)
              || (request.resource.data.type == 'RETIRO'
                && exists(playerPath(playerId))
                && get(playerPath(playerId)).data.active == true
                && getAfter(playerPath(playerId)).data.active == false)
              || (request.resource.data.type == 'REACTIVACION'
                && exists(playerPath(playerId))
                && get(playerPath(playerId)).data.active == false
                && getAfter(playerPath(playerId)).data.active == true));

        allow update, delete: if false;
      }
    }

    // Todo lo demás queda cerrado hasta que lo abra su historia de usuario.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
