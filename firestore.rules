rules_version = '2';

// Reglas de seguridad de Cloud Firestore – SportPro
// US-001 (registro con código de invitación e inicio de sesión)
// US-002 (academia, equipos, usuarios e invitaciones de DT por el ADM)
// US-003 (plantel y perfil del jugador, códigos JUG/PAD)
// US-006 (partidos, convocatoria, respuestas y alineación)
// US-007 (catálogo configurable de tipos de evento)
// US-008 (operadores, cronómetro, eventos del partido, observaciones y directorio de la academia)
// US-010 (lectura en tiempo real de eventos por los miembros de la academia)
// Notificaciones: bandeja dentro de la app (base de la US-012).
// Se amplían en US-016.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function invitationAfter(code) {
      return getAfter(/databases/$(database)/documents/invitations/$(code)).data;
    }

    // ---------- US-002 ----------

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function academyPath(academyId) {
      return /databases/$(database)/documents/academies/$(academyId);
    }

    function teamPath(academyId, teamId) {
      return /databases/$(database)/documents/academies/$(academyId)/teams/$(teamId);
    }

    // Perfil de quien hace la petición
    function myProfile() {
      return get(userPath(request.auth.uid)).data;
    }

    // Miembro activo de la academia (ADM, DT, JUG o PAD)
    function isMemberOf(academyId) {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && myProfile().academyId == academyId
        && myProfile().status == 'active';
    }

    // Administrador activo de ESA academia
    function isAdmOf(academyId) {
      return isMemberOf(academyId) && myProfile().role == 'ADM';
    }

    // Datos válidos de una academia (logo: 150 KB en Base64 = 204800 caracteres como máximo)
    function validAcademy(data) {
      return data.name is string && data.name.size() >= 3 && data.name.size() <= 80
        && data.city is string && data.city.size() > 0 && data.city.size() <= 60
        && data.institutionalEmail is string && data.institutionalEmail.size() <= 100
        // formato de correo sencillo (la app valida con un patrón más estricto)
        && data.institutionalEmail.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && data.logoBase64 is string && data.logoBase64.size() <= 204800
        // RN-008: plazos de convocatoria
        && data.callupNoticeHours is int && data.callupNoticeHours >= 1 && data.callupNoticeHours <= 168
        && data.callupConfirmHours is int && data.callupConfirmHours >= 0
        && data.callupConfirmHours < data.callupNoticeHours;
    }

    // Datos válidos de un equipo (RN-004: categoría de la lista)
    function validTeam(data) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 40
        && data.category in ['Sub-8', 'Sub-10', 'Sub-12', 'Sub-15', 'Sub-17', 'Primera', 'Otra']
        && data.maxStarters is int && data.maxStarters >= 1 && data.maxStarters <= 11
        && data.maxSubstitutes is int && data.maxSubstitutes >= 0 && data.maxSubstitutes <= 20
        && data.active is bool;
    }

    // Un campo que no cambia en la actualización
    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    // ---------- US-003 ----------

    function playerPath(playerId) {
      return /databases/$(database)/documents/players/$(playerId);
    }

    function privatePath(playerId) {
      return /databases/$(database)/documents/players/$(playerId)/private/data;
    }

    function invitationPath(code) {
      return /databases/$(database)/documents/invitations/$(code);
    }

    // DT activo de ESE equipo (el DT es el usuario con role "DT" y teamId del equipo).
    // El equipo debe estar activo: el DT de un equipo desactivado ya no ve a sus jugadores.
    function isDtOfTeam(academyId, teamId) {
      return isMemberOf(academyId) && myProfile().role == 'DT' && myProfile().teamId == teamId
        && get(teamPath(academyId, teamId)).data.active == true;
    }

    // Gestiona al jugador: el ADM de su academia o el DT de su equipo
    function canManage(player) {
      return isAdmOf(player.academyId) || isDtOfTeam(player.academyId, player.teamId);
    }

    // Su apoderado o el propio jugador mayor de edad (con cuenta ACTIVA)
    function isFamily(player) {
      return signedIn()
        && (request.auth.uid in player.guardianIds
            || (player.userId != '' && player.userId == request.auth.uid))
        && exists(userPath(request.auth.uid))
        && myProfile().status == 'active';
    }

    // Tiene 18 años o más (misma tolerancia de 6573 días que el registro de la US-001)
    function isAdultBirthDate(birthDate) {
      return birthDate <= request.time - duration.value(6573, 'd');
    }

    // Datos deportivos válidos
    function validPlayer(data) {
      return data.name is string && data.name.size() >= 3 && data.name.size() <= 60
        && data.category in ['Sub-8', 'Sub-10', 'Sub-12', 'Sub-15', 'Sub-17', 'Primera', 'Otra']
        && data.positionMain in ['Portero', 'Defensa central', 'Lateral', 'Mediocampista defensivo', 'Mediocampista', 'Mediocampista ofensivo', 'Extremo', 'Delantero']
        && data.positionSecondary in ['', 'Portero', 'Defensa central', 'Lateral', 'Mediocampista defensivo', 'Mediocampista', 'Mediocampista ofensivo', 'Extremo', 'Delantero']
        && (data.dorsal == null || (data.dorsal is int && data.dorsal >= 1 && data.dorsal <= 99))
        && data.foot in ['Derecho', 'Izquierdo', 'Ambos']
        && data.isMinor is bool
        && data.active is bool
        && data.hasEmergencyContact is bool
        && data.userId is string
        && data.guardianIds is list;
    }

    // Un jugador no puede quedar como "mayor de edad" si su fecha de nacimiento dice que es menor
    function minorFlagOk(player, privateData) {
      return player.isMinor == true || isAdultBirthDate(privateData.birthDate);
    }

    // Autorización del apoderado (Reglamento D.S. 016-2024-JUS, art. 22) declarada EN ESTA operación
    // por quien la hace (los mayores no tienen estos campos).
    function guardianAuthorizedNow(data) {
      return data.get('guardianAuthorization', false) == true
        && data.get('guardianAuthorizationBy', '') == request.auth.uid
        && data.get('guardianAuthorizationByName', null) is string
        && data.guardianAuthorizationByName.size() <= 60
        && data.get('guardianAuthorizationAt', null) == request.time;
    }

    // Datos privados válidos (foto: 150 KB en Base64 = 204800 caracteres como máximo; RN-014)
    function validPrivate(data) {
      return data.birthDate is timestamp && data.birthDate < request.time
        && data.contactPhone is string && (data.contactPhone == '' || data.contactPhone.matches('^9[0-9]{8}$'))
        && data.emergencyName is string && data.emergencyName.size() <= 60
        && data.emergencyRelation is string && data.emergencyRelation.size() <= 30
        && data.emergencyPhone is string && (data.emergencyPhone == '' || data.emergencyPhone.matches('^9[0-9]{8}$'))
        && data.photoBase64 is string && data.photoBase64.size() <= 204800
        && (data.heightCm == null || (data.heightCm is int && data.heightCm >= 100 && data.heightCm <= 220))
        && (data.weightKg == null || (data.weightKg is int && data.weightKg >= 20 && data.weightKg <= 150));
    }

    // RN-005: contacto de emergencia completo (nombre, parentesco y celular)
    function emergencyComplete(data) {
      return data.emergencyName.size() > 0 && data.emergencyRelation.size() > 0 && data.emergencyPhone.size() > 0;
    }

    // El código se gastó EN ESTA MISMA operación, por quien hace la petición, con ese rol y para ese jugador
    // (antes no estaba usado y después sí: un código viejo ya usado no sirve para volver a vincularse)
    function invitationUsedNow(code, role, playerId) {
      return get(invitationPath(code)).data.get('used', false) == false
        && getAfter(invitationPath(code)).data.usedBy == request.auth.uid
        && getAfter(invitationPath(code)).data.role == role
        && getAfter(invitationPath(code)).data.playerId == playerId;
    }

    // Código JUG/PAD válido para un jugador (lo crea el DT de su equipo o el ADM de su academia)
    function validPlayerInvitation(data, playerId) {
      return canManage(get(playerPath(playerId)).data)
        && get(playerPath(playerId)).data.active == true
        && get(playerPath(playerId)).data.userId == ''
        && data.academyId == get(playerPath(playerId)).data.academyId
        && data.teamId == get(playerPath(playerId)).data.teamId
        // PRIVACIDAD: nombre corto ("Mateo R."): cualquiera con el código lo puede leer
        && data.playerName is string && data.playerName.size() > 0 && data.playerName.size() <= 30
        && data.invitedByName is string && data.invitedByName.size() > 0 && data.invitedByName.size() <= 80
        // Lo que ve quien se registra debe coincidir con la academia y el equipo reales
        && data.academyName == get(academyPath(data.academyId)).data.name
        && data.city == get(academyPath(data.academyId)).data.city
        && data.teamName == get(teamPath(data.academyId, data.teamId)).data.name
        && get(teamPath(data.academyId, data.teamId)).data.active == true
        // PAD: solo para un menor. JUG: solo si ya tiene 18 años según su fecha de nacimiento real.
        && ((data.role == 'PAD' && get(playerPath(playerId)).data.isMinor == true)
            || (data.role == 'JUG' && isAdultBirthDate(get(privatePath(playerId)).data.birthDate)));
    }

    // Códigos de invitación: el ID del documento es el código.
    match /invitations/{code} {
      // Se puede consultar UN código conocido (para validarlo), pero no listar todos.
      allow get: if true;

      // US-002: el ADM lista los códigos de SU academia (consulta con where academyId == ...)
      allow list: if signedIn() && isAdmOf(resource.data.academyId);

      // US-003: el DT lista los códigos JUG/PAD de SU equipo
      // (consulta con where academyId == ..., teamId == ... y role in ['JUG', 'PAD'])
      allow list: if signedIn()
        && resource.data.role in ['JUG', 'PAD']
        && isDtOfTeam(resource.data.academyId, resource.data.teamId);

      // US-001: solo se puede marcar como usado una vez, por la persona que se registra,
      // si no venció ni fue anulado, y cambiando únicamente used / usedBy / usedAt.
      allow update: if signedIn()
        && resource.data.get('used', false) == false
        && resource.data.get('status', 'PENDIENTE') != 'ANULADO'
        && (!('expiresAt' in resource.data) || request.time < resource.data.expiresAt)
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'usedAt'])
        // el código solo se gasta en la misma transacción que crea el perfil
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
        // quien ya tiene perfil no puede gastar otro código
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid));

      // US-002 (RN-002): el ADM anula un código de su academia que aún no se usó.
      // Anular = status "ANULADO"; no se cambia nada más y el código no se borra.
      allow update: if signedIn()
        && isAdmOf(resource.data.academyId)
        && resource.data.get('used', false) == false
        && request.resource.data.status == 'ANULADO'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      // US-002: al renombrar la academia o cambiar su ciudad, el ADM actualiza esas copias en sus
      // códigos sin usar (solo academyName, invitedByName y city, y solo con los valores reales de la
      // academia después del cambio, en la misma operación).
      // invitedByName solo puede quedar como "la administración de <nombre nuevo>".
      allow update: if signedIn()
        && isAdmOf(resource.data.academyId)
        && resource.data.get('used', false) == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['academyName', 'invitedByName', 'city'])
        && (unchanged('academyName')
            || request.resource.data.academyName == getAfter(academyPath(resource.data.academyId)).data.name)
        && (unchanged('invitedByName')
            || request.resource.data.invitedByName == 'la administración de ' + getAfter(academyPath(resource.data.academyId)).data.name)
        && (unchanged('city')
            || request.resource.data.city == getAfter(academyPath(resource.data.academyId)).data.city);

      // US-002: al renombrar un equipo, el ADM actualiza teamName en sus códigos sin usar
      // (solo teamName, y solo con el nombre real del equipo después del cambio).
      allow update: if signedIn()
        && isAdmOf(resource.data.academyId)
        && resource.data.get('used', false) == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teamName'])
        && request.resource.data.teamName == getAfter(teamPath(resource.data.academyId, resource.data.teamId)).data.name;

      // US-002: el ADM crea códigos de DT para un equipo ACTIVO de su academia (vencen en 7 días).
      // Los códigos de apoderado los crea el DT en la US-003.
      allow create: if signedIn()
        && isAdmOf(request.resource.data.academyId)
        // Formato PREFIJO-XXXXXX: 4 letras del nombre + 6 caracteres sin confusiones
        && code.matches('^[A-Z]{4}-[A-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['academyId', 'academyName', 'city', 'role', 'teamId', 'teamName', 'invitedByName', 'playerId', 'playerName', 'used', 'status', 'createdAt', 'expiresAt', 'createdBy'])
        && request.resource.data.role == 'DT'
        && request.resource.data.used == false
        && request.resource.data.status == 'PENDIENTE'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.playerId == ''
        && request.resource.data.playerName == ''
        // Lo que ve quien se registra debe coincidir con la academia y el equipo reales
        && request.resource.data.academyName == get(academyPath(request.resource.data.academyId)).data.name
        && request.resource.data.city == get(academyPath(request.resource.data.academyId)).data.city
        && request.resource.data.teamName == get(teamPath(request.resource.data.academyId, request.resource.data.teamId)).data.name
        && get(teamPath(request.resource.data.academyId, request.resource.data.teamId)).data.active == true
        // el texto "invitado por" es siempre el de la administración de esa academia
        && request.resource.data.invitedByName == 'la administración de ' + get(academyPath(request.resource.data.academyId)).data.name
        // fecha de creación del servidor y vencimiento en el futuro (a lo mucho 8 días)
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(8, 'd');

      // US-003 (RN-002, RN-003): el DT (para jugadores de su equipo) o el ADM (para cualquiera de
      // su academia) crea un código PAD para el apoderado de un menor o un código JUG para un
      // jugador que ya tiene 18 años. Vencen en 7 días.
      allow create: if signedIn()
        && code.matches('^[A-Z]{4}-[A-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['academyId', 'academyName', 'city', 'role', 'teamId', 'teamName', 'invitedByName', 'playerId', 'playerName', 'used', 'status', 'createdAt', 'expiresAt', 'createdBy'])
        && request.resource.data.role in ['JUG', 'PAD']
        && request.resource.data.used == false
        && request.resource.data.status == 'PENDIENTE'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.playerId is string
        && request.resource.data.playerId != ''
        && validPlayerInvitation(request.resource.data, request.resource.data.playerId)
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(8, 'd');

      // US-003: el DT anula un código JUG/PAD de su equipo que aún no se usó (el ADM ya puede, arriba)
      allow update: if signedIn()
        && resource.data.role in ['JUG', 'PAD']
        && isDtOfTeam(resource.data.academyId, resource.data.teamId)
        && resource.data.get('used', false) == false
        && request.resource.data.status == 'ANULADO'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      // US-003: "Vincular otro jugador". Un apoderado que YA tiene cuenta usa un nuevo código PAD
      // de SU academia. Solo en la misma operación que lo agrega como apoderado de ese jugador.
      // (La regla de la US-001 de arriba sigue exigiendo que quien se registra no tenga perfil.)
      allow update: if signedIn()
        && resource.data.role == 'PAD'
        && resource.data.get('used', false) == false
        && resource.data.get('status', 'PENDIENTE') != 'ANULADO'
        && (!('expiresAt' in resource.data) || request.time < resource.data.expiresAt)
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'usedAt'])
        && isMemberOf(resource.data.academyId)
        && myProfile().role == 'PAD'
        && request.auth.uid in getAfter(playerPath(resource.data.playerId)).data.guardianIds
        && getAfter(playerPath(resource.data.playerId)).data.lastInvitationCode == code;

      // Nunca se borran
      allow delete: if false;
    }

    // Perfil de cada usuario (solo personas de 18 años o más tienen cuenta)
    match /users/{uid} {
      // Cada persona lee su perfil; el ADM lee los perfiles de su academia (US-002)
      allow read: if signedIn()
        && (request.auth.uid == uid || isAdmOf(resource.data.academyId));

      // US-001: se crea en la misma transacción que marca el código como usado:
      // el rol y la academia deben coincidir con los del código y debe aceptar los términos de uso.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'phoneNumber', 'birthDate', 'invitationCode', 'role', 'academyId', 'academyName', 'teamId', 'playerId', 'status', 'termsAccepted', 'createdAt'])
        && request.resource.data.status == 'pending_verification'
        && request.resource.data.termsAccepted.version is string
        // RN-003: solo mayores de 18 años.
        // La app valida la edad exacta (años cumplidos); esta regla es una segunda barrera.
        // Se usa 6573 días por dos motivos:
        //  - 18 años son 6574 o 6575 días según cuántos años bisiestos haya de por medio.
        //  - La app guarda la fecha a las 12:00 (mediodía) UTC, así que el día del cumpleaños
        //    en Lima (UTC-5) aún no se completan los días antes de las 7:00 a. m.
        // Con 6573 nunca se rechaza a quien cumple 18 hoy (a lo mucho deja pasar 1-2 días antes).
        && request.resource.data.birthDate is timestamp
        && request.resource.data.birthDate <= request.time - duration.value(6573, 'd')
        && invitationAfter(request.resource.data.invitationCode).usedBy == request.auth.uid
        && request.resource.data.role == invitationAfter(request.resource.data.invitationCode).role
        && request.resource.data.academyId == invitationAfter(request.resource.data.invitationCode).academyId
        // el nombre de la academia que se copia al perfil debe ser el real
        && request.resource.data.academyName == get(academyPath(request.resource.data.academyId)).data.name
        && request.resource.data.teamId == invitationAfter(request.resource.data.invitationCode).get('teamId', '')
        && request.resource.data.playerId == invitationAfter(request.resource.data.invitationCode).get('playerId', '')
        // US-002: los códigos DT, JUG y PAD solo sirven si su equipo sigue activo
        && (!(request.resource.data.role in ['DT', 'JUG', 'PAD'])
            || get(teamPath(request.resource.data.academyId, request.resource.data.teamId)).data.active == true);

      // US-002: "Registrar mi academia". El perfil ADM se crea SIN código, en la misma
      // transacción que crea su academia (nueva) con adminUid = su uid.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'phoneNumber', 'birthDate', 'invitationCode', 'role', 'academyId', 'academyName', 'teamId', 'playerId', 'status', 'termsAccepted', 'createdAt'])
        && request.resource.data.status == 'pending_verification'
        && request.resource.data.termsAccepted.version is string
        // RN-003: misma regla de edad que arriba
        && request.resource.data.birthDate is timestamp
        && request.resource.data.birthDate <= request.time - duration.value(6573, 'd')
        && request.resource.data.role == 'ADM'
        && request.resource.data.invitationCode == ''
        && request.resource.data.teamId == ''
        && request.resource.data.playerId == ''
        && request.resource.data.academyId is string
        // la academia es nueva (no existía) y queda creada en esta misma operación, a su nombre
        && !exists(academyPath(request.resource.data.academyId))
        && existsAfter(academyPath(request.resource.data.academyId))
        && getAfter(academyPath(request.resource.data.academyId)).data.adminUid == request.auth.uid
        && request.resource.data.academyName == getAfter(academyPath(request.resource.data.academyId)).data.name;

      // US-001: tras verificar el correo, la cuenta pasa de "pending_verification" a "active".
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && resource.data.status == 'pending_verification'
        && request.resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      // US-002: el ADM actualiza perfiles de SU academia, solo estos campos:
      //  - status: active <-> inactive (desactivar/reactivar), nunca el suyo
      //    ni el de cuentas bloqueadas o sin verificar
      //  - teamId: el DT de un equipo ("" = sin equipo, o un equipo ACTIVO de la academia);
      //    al desactivar a un DT o su equipo, queda en ""
      //  - academyName: la copia del nombre cuando se renombra la academia
      allow update: if signedIn()
        && isAdmOf(resource.data.academyId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'teamId', 'academyName'])
        && (unchanged('status') || (
              request.auth.uid != uid
              && resource.data.status in ['active', 'inactive']
              && request.resource.data.status in ['active', 'inactive']))
        && (unchanged('teamId') || (
              resource.data.role == 'DT'
              && (request.resource.data.teamId == ''
                  || getAfter(teamPath(resource.data.academyId, request.resource.data.teamId)).data.active == true)))
        && (unchanged('academyName')
              || request.resource.data.academyName == getAfter(academyPath(resource.data.academyId)).data.name);

      // Nunca se borran (desactivar = status "inactive")
      allow delete: if false;
    }

    // US-002: academias
    match /academies/{academyId} {
      // La leen los miembros activos de la academia
      allow read: if isMemberOf(academyId);

      // Solo se crea en el registro del ADM, en la misma transacción que su perfil.
      // "verified" empieza en false y solo se cambia desde la consola (RN-018).
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'city', 'institutionalEmail', 'logoBase64', 'callupNoticeHours', 'callupConfirmHours', 'verified', 'adminUid', 'createdAt'])
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.verified == false
        && validAcademy(request.resource.data)
        // quien ya tiene perfil no puede crear otra academia: una cuenta = una academia
        && !exists(userPath(request.auth.uid))
        && getAfter(userPath(request.auth.uid)).data.role == 'ADM'
        && getAfter(userPath(request.auth.uid)).data.academyId == academyId;

      // El ADM edita los datos, sin tocar verified ni adminUid
      allow update: if isAdmOf(academyId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'city', 'institutionalEmail', 'logoBase64', 'callupNoticeHours', 'callupConfirmHours'])
        && validAcademy(request.resource.data);

      allow delete: if false;

      // Equipos de la academia (el DT NO se guarda aquí: es el usuario DT con ese teamId)
      match /teams/{teamId} {
        allow read: if isMemberOf(academyId);

        allow create: if isAdmOf(academyId)
          && request.resource.data.keys().hasOnly(['name', 'category', 'maxStarters', 'maxSubstitutes', 'active', 'createdAt'])
          && request.resource.data.active == true
          && validTeam(request.resource.data);

        // Editar o desactivar (active = false); nunca se borra
        allow update: if isAdmOf(academyId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'category', 'maxStarters', 'maxSubstitutes', 'active'])
          && validTeam(request.resource.data);

        allow delete: if false;
      }

      // US-007: catálogo de eventos de la academia. Lo leen sus miembros activos (el DT lo ve en
      // solo lectura); solo el ADM lo crea y edita. Nada se borra: desactivar = active false.
      match /eventTypes/{typeId} {
        allow read: if isMemberOf(academyId);

        allow create: if isAdmOf(academyId)
          && request.resource.data.keys().hasOnly(['name', 'icon', 'color', 'affectsScore', 'requiresPlayer', 'requiresTeam', 'allowsNote', 'active', 'system', 'order', 'createdAt', 'updatedAt'])
          && validEventType(typeId, request.resource.data)
          // Los de fábrica tienen su clave como ID; los nuevos del ADM empiezan activos y no son de fábrica
          && request.resource.data.system == (typeId in defaultEventTypeIds())
          && (request.resource.data.system == true || request.resource.data.active == true)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        // Editar, desactivar o reactivar (system y createdAt no cambian)
        allow update: if isAdmOf(academyId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'icon', 'color', 'affectsScore', 'requiresPlayer', 'requiresTeam', 'allowsNote', 'active', 'order', 'updatedAt'])
          && validEventType(typeId, request.resource.data)
          && request.resource.data.updatedAt == request.time;

        allow delete: if false;
      }

      // US-008: directorio mínimo de la academia (para elegir operadores del partido).
      // PRIVACIDAD: solo nombre, rol y estado; nunca correo, celular ni fecha de nacimiento.
      // Lo leen solo el DT y el ADM de la academia.
      match /members/{uid} {
        allow read: if isMemberOf(academyId) && myProfile().role in ['DT', 'ADM'];

        // Cada usuario ACTIVO escribe su propia ficha, con el nombre y el rol de SU perfil real
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && isMemberOf(academyId)
          && validMember(request.resource.data)
          && request.resource.data.name == myProfile().name
          && request.resource.data.role == myProfile().role
          && request.resource.data.status == 'active';

        // El ADM la deja al día al desactivar o reactivar una cuenta: nombre, rol y estado deben ser los
        // del perfil real DESPUÉS del cambio (misma operación)
        allow create, update: if isAdmOf(academyId)
          && validMember(request.resource.data)
          && getAfter(userPath(uid)).data.academyId == academyId
          && request.resource.data.name == getAfter(userPath(uid)).data.name
          && request.resource.data.role == getAfter(userPath(uid)).data.role
          && request.resource.data.status == getAfter(userPath(uid)).data.status;

        allow delete: if false;
      }
    }

    // US-008: ficha válida del directorio
    function validMember(data) {
      return data.keys().hasOnly(['name', 'role', 'status', 'updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.role in ['ADM', 'DT', 'JUG', 'PAD']
        && data.status in ['active', 'inactive']
        && data.updatedAt == request.time;
    }

    // ---------- US-007 ----------

    // Claves de los tipos de evento de fábrica
    function defaultEventTypeIds() {
      return ['inicio', 'fin', 'gol', 'tarjeta_amarilla', 'tarjeta_roja', 'cambio', 'falta', 'penal',
              'fuera_de_juego', 'tiro_de_esquina', 'saque_lateral', 'saque_de_meta'];
    }

    // Tipo de evento válido: ícono y color de las listas fijas de la app.
    // Afectar el marcador o pedir jugador exige saber de qué equipo es.
    // 'Inicio' y 'Fin' siempre están activos y no afectan el marcador ni piden jugador ni equipo.
    function validEventType(typeId, data) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 30
        && data.icon in ['balon', 'inicio', 'fin', 'tarjeta', 'cambio', 'silbato', 'penal', 'prohibido',
                         'banderin', 'mano', 'escudo', 'reloj', 'advertencia', 'estrella']
        && data.color in ['#0E6B6F', '#2E7D32', '#1565C0', '#F2B705', '#C2410C', '#6A4C93', '#5F6B6D', '#E8710A']
        && data.affectsScore is bool && data.requiresPlayer is bool
        && data.requiresTeam is bool && data.allowsNote is bool
        && data.active is bool && data.system is bool
        && data.order is int && data.order >= 0 && data.order <= 999
        && (!(data.affectsScore || data.requiresPlayer) || data.requiresTeam)
        && (!(typeId in ['inicio', 'fin'])
            || (data.active == true && data.affectsScore == false
                && data.requiresPlayer == false && data.requiresTeam == false));
    }

    // US-003: jugadores (datos deportivos). Nunca se borran: retirar = active false (RN-004).
    // Los leen el ADM de la academia, el DT activo de su equipo, sus apoderados y el propio jugador.
    match /players/{playerId} {
      allow read: if canManage(resource.data) || isFamily(resource.data);

      // "Nuevo jugador": DT de un equipo ACTIVO o ADM de la academia, en la misma operación
      // que sus datos privados (fecha de nacimiento). Empieza sin cuenta y sin apoderados.
      // Un menor necesita la autorización del apoderado que declara quien lo registra.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['academyId', 'teamId', 'name', 'category', 'positionMain', 'positionSecondary', 'dorsal', 'foot', 'isMinor', 'userId', 'guardianIds', 'hasEmergencyContact', 'active', 'lastInvitationCode', 'createdAt', 'createdBy', 'guardianAuthorization', 'guardianAuthorizationBy', 'guardianAuthorizationByName', 'guardianAuthorizationAt'])
        && (request.resource.data.isMinor == false || guardianAuthorizedNow(request.resource.data))
        // si se escribe la autorización (también en un mayor), debe ser verdadera, suya y de este momento
        && (!('guardianAuthorization' in request.resource.data) || guardianAuthorizedNow(request.resource.data))
        && canManage(request.resource.data)
        && validPlayer(request.resource.data)
        && request.resource.data.userId == ''
        && request.resource.data.guardianIds.size() == 0
        && request.resource.data.hasEmergencyContact == false
        && request.resource.data.active == true
        && request.resource.data.lastInvitationCode == ''
        && request.resource.data.createdBy == request.auth.uid
        && get(teamPath(request.resource.data.academyId, request.resource.data.teamId)).data.active == true
        && existsAfter(privatePath(playerId))
        && minorFlagOk(request.resource.data, getAfter(privatePath(playerId)).data);

      // DT de su equipo o ADM: datos deportivos, si es menor (con la fecha de nacimiento),
      // traslado (solo a otro equipo ACTIVO de la MISMA academia) y retirar/reactivar.
      allow update: if canManage(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'category', 'positionMain', 'positionSecondary', 'dorsal', 'foot', 'isMinor', 'teamId', 'active', 'guardianAuthorization', 'guardianAuthorizationBy', 'guardianAuthorizationByName', 'guardianAuthorizationAt'])
        && validPlayer(request.resource.data)
        // Todo menor queda con la autorización del apoderado (si pasa de mayor a menor, se declara aquí)
        && (request.resource.data.isMinor == false
            || request.resource.data.get('guardianAuthorization', false) == true)
        // La autorización no se borra ni se falsea: si cambia, es verdadera, de quien edita y de este momento
        && ((unchanged('guardianAuthorization') && unchanged('guardianAuthorizationBy')
              && unchanged('guardianAuthorizationByName') && unchanged('guardianAuthorizationAt'))
            || guardianAuthorizedNow(request.resource.data))
        && (unchanged('teamId')
            || get(teamPath(resource.data.academyId, request.resource.data.teamId)).data.active == true)
        && (unchanged('isMinor') || minorFlagOk(request.resource.data, getAfter(privatePath(playerId)).data))
        // un jugador con cuenta propia no puede volver a ser menor de edad
        && (resource.data.userId == '' || request.resource.data.isMinor == false)
        // solo se reactiva si su equipo está activo (si no, primero se traslada)
        && (unchanged('active') || request.resource.data.active == false
            || get(teamPath(resource.data.academyId, request.resource.data.teamId)).data.active == true);

      // Apoderado o jugador mayor: solo hasEmergencyContact, y debe coincidir con sus datos privados
      allow update: if isFamily(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hasEmergencyContact'])
        && request.resource.data.hasEmergencyContact == emergencyComplete(getAfter(privatePath(playerId)).data);

      // Uso de un código PAD (registro US-001 o "Vincular otro jugador"): se agrega a sí mismo
      // como apoderado, en la misma operación que gasta el código para ESTE jugador.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guardianIds', 'lastInvitationCode'])
        && request.resource.data.guardianIds.toSet() == resource.data.guardianIds.toSet().union([request.auth.uid].toSet())
        && invitationUsedNow(request.resource.data.lastInvitationCode, 'PAD', playerId);

      // Uso de un código JUG (registro US-001): el jugador mayor asume su cuenta y su gestión;
      // se retira el vínculo con sus apoderados.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId', 'guardianIds', 'isMinor', 'lastInvitationCode'])
        && resource.data.userId == ''
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.guardianIds.size() == 0
        && request.resource.data.isMinor == false
        && invitationUsedNow(request.resource.data.lastInvitationCode, 'JUG', playerId)
        // la fecha de nacimiento de la cuenta nueva debe ser la del perfil del jugador
        && getAfter(userPath(request.auth.uid)).data.birthDate == get(privatePath(playerId)).data.birthDate;

      allow delete: if false;

      // Datos privados: players/{playerId}/private/data (RN-005, RN-014)
      match /private/{docId} {
        allow read: if docId == 'data'
          && (canManage(get(playerPath(playerId)).data) || isFamily(get(playerPath(playerId)).data));

        // Se crea junto con el jugador ("Nuevo jugador")
        allow create: if docId == 'data'
          && request.resource.data.keys().hasOnly(['birthDate', 'contactPhone', 'emergencyName', 'emergencyRelation', 'emergencyPhone', 'photoBase64', 'heightCm', 'weightKg'])
          && !exists(playerPath(playerId))
          && existsAfter(playerPath(playerId))
          && canManage(getAfter(playerPath(playerId)).data)
          && validPrivate(request.resource.data);

        // DT de su equipo o ADM: solo la fecha de nacimiento
        // (y "es menor" del jugador debe seguir siendo coherente con la fecha nueva)
        allow update: if docId == 'data'
          && canManage(get(playerPath(playerId)).data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['birthDate'])
          && validPrivate(request.resource.data)
          && minorFlagOk(getAfter(playerPath(playerId)).data, request.resource.data);

        // Apoderado o jugador mayor: contacto, emergencia, foto y datos físicos (nunca la fecha de nacimiento)
        allow update: if docId == 'data'
          && isFamily(get(playerPath(playerId)).data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contactPhone', 'emergencyName', 'emergencyRelation', 'emergencyPhone', 'photoBase64', 'heightCm', 'weightKg'])
          && validPrivate(request.resource.data);

        allow delete: if false;
      }

      // Historial del jugador (RN-004): altas, traslados, retiros y reactivaciones.
      // Lo escribe el DT o el ADM en la misma operación del cambio; nunca se edita ni se borra.
      match /history/{entryId} {
        allow read: if canManage(get(playerPath(playerId)).data);

        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['type', 'fromTeamId', 'fromTeamName', 'toTeamId', 'toTeamName', 'byUid', 'byName', 'at'])
          && request.resource.data.type in ['ALTA', 'TRASLADO', 'RETIRO', 'REACTIVACION']
          && request.resource.data.byUid == request.auth.uid
          && request.resource.data.at == request.time
          // quien gestionaba al jugador ANTES del cambio (en un traslado, el DT del equipo anterior);
          // si el jugador es nuevo, quien lo está creando
          && ((exists(playerPath(playerId)) && canManage(get(playerPath(playerId)).data))
              || (!exists(playerPath(playerId)) && canManage(getAfter(playerPath(playerId)).data)))
          // la entrada debe corresponder al cambio que se hace en esta misma operación
          && ((request.resource.data.type == 'ALTA'
                && !exists(playerPath(playerId)) && existsAfter(playerPath(playerId)))
              || (request.resource.data.type == 'TRASLADO'
                && exists(playerPath(playerId))
                && getAfter(playerPath(playerId)).data.teamId != get(playerPath(playerId)).data.teamId
                && request.resource.data.toTeamId == getAfter(playerPath(playerId)).data.teamId
                && request.resource.data.fromTeamId == get(playerPath(playerId)).data.teamId)
              || (request.resource.data.type == 'RETIRO'
                && exists(playerPath(playerId))
                && get(playerPath(playerId)).data.active == true
                && getAfter(playerPath(playerId)).data.active == false)
              || (request.resource.data.type == 'REACTIVACION'
                && exists(playerPath(playerId))
                && get(playerPath(playerId)).data.active == false
                && getAfter(playerPath(playerId)).data.active == true));

        allow update, delete: if false;
      }
    }

    // ---------- US-006 ----------

    function matchPath(matchId) {
      return /databases/$(database)/documents/matches/$(matchId);
    }

    function callupPath(matchId, playerId) {
      return /databases/$(database)/documents/matches/$(matchId)/callups/$(playerId);
    }

    // Posiciones de la alineación (las mismas de PLAYER_POSITIONS en la app)
    function positions() {
      return ['Portero', 'Defensa central', 'Lateral', 'Mediocampista defensivo', 'Mediocampista',
              'Mediocampista ofensivo', 'Extremo', 'Delantero'];
    }

    // El titular número i (si existe) tiene solo jugador, nombre corto y una posición de la lista.
    // Las reglas no tienen bucles: se revisa cada índice posible (hasta 11 titulares, validTeam).
    function validStarterAt(starters, i) {
      return starters.size() <= i
        || (starters[i] is map
            && starters[i].keys().hasOnly(['playerId', 'playerName', 'position'])
            && starters[i].playerId is string
            && starters[i].playerName is string && starters[i].playerName.size() <= 30
            && starters[i].position in positions());
    }

    function validStarters(starters) {
      return validStarterAt(starters, 0) && validStarterAt(starters, 1) && validStarterAt(starters, 2)
        && validStarterAt(starters, 3) && validStarterAt(starters, 4) && validStarterAt(starters, 5)
        && validStarterAt(starters, 6) && validStarterAt(starters, 7) && validStarterAt(starters, 8)
        && validStarterAt(starters, 9) && validStarterAt(starters, 10);
    }

    // Datos válidos de un partido (rival, lugar y fecha-hora)
    function validMatch(data) {
      return data.rival is string && data.rival.size() >= 2 && data.rival.size() <= 40
        && data.place is string && data.place.size() >= 2 && data.place.size() <= 80
        && data.startsAt is timestamp
        && data.teamName is string && data.teamName.size() <= 40;
    }

    // El partido sigue abierto: programado o convocado y todavía no empieza
    function matchOpen(matchData) {
      return matchData.status in ['PROGRAMADO', 'CONVOCADO'] && request.time < matchData.startsAt;
    }

    // Quién responde la convocatoria (RN-003): si el jugador es menor, uno de sus apoderados;
    // si es mayor, solo el propio jugador con su cuenta. Con la cuenta ACTIVA y de la misma academia.
    function isResponder(player) {
      return signedIn()
        && ((player.isMinor == true && request.auth.uid in player.guardianIds)
            || (player.isMinor == false && player.userId != '' && player.userId == request.auth.uid))
        && exists(userPath(request.auth.uid))
        && myProfile().status == 'active'
        && myProfile().academyId == player.academyId;
    }

    // Se puede responder: partido convocado (no cancelado ni empezado) y dentro del plazo de la
    // academia (hasta callupConfirmHours antes del inicio, RN-008).
    // Lecturas: perfil, partido, academia y jugador (4 de las 10 permitidas).
    function canRespond(matchId, playerId) {
      let m = get(matchPath(matchId)).data;
      let p = get(playerPath(playerId)).data;
      return m.status == 'CONVOCADO'
        && p.academyId == m.academyId
        && request.time <= m.startsAt - duration.value(get(academyPath(m.academyId)).data.callupConfirmHours, 'h')
        && isResponder(p);
    }

    // US-006: partidos (colección raíz). Nunca se borran: cancelar = status "CANCELADO".
    // Los leen los miembros activos de la academia (datos generales del partido).
    match /matches/{matchId} {
      allow read: if isMemberOf(resource.data.academyId);

      // "Nuevo partido": el DT de ESE equipo (activo), en el futuro, empieza "Programado"
      allow create: if isDtOfTeam(request.resource.data.academyId, request.resource.data.teamId)
        && request.resource.data.keys().hasOnly(['academyId', 'teamId', 'teamName', 'rival', 'startsAt', 'place', 'status', 'createdBy', 'createdAt', 'updatedAt'])
        && validMatch(request.resource.data)
        && request.resource.data.teamName == get(teamPath(request.resource.data.academyId, request.resource.data.teamId)).data.name
        && request.resource.data.startsAt > request.time
        && request.resource.data.status == 'PROGRAMADO'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Publicar la convocatoria: de "Programado" a "Convocado", antes del inicio
      allow update: if isDtOfTeam(resource.data.academyId, resource.data.teamId)
        && resource.data.status == 'PROGRAMADO'
        && request.time < resource.data.startsAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'callupPublishedAt', 'updatedAt'])
        && request.resource.data.status == 'CONVOCADO'
        && request.resource.data.callupPublishedAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Reprogramar (antes del inicio): solo fecha-hora y lugar, a un momento futuro.
      // El estado y las respuestas de la convocatoria se mantienen.
      allow update: if isDtOfTeam(resource.data.academyId, resource.data.teamId)
        && matchOpen(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['startsAt', 'place', 'updatedAt'])
        && validMatch(request.resource.data)
        && request.resource.data.startsAt > request.time
        && request.resource.data.updatedAt == request.time;

      // Cancelar (antes del inicio): status "CANCELADO". No se borra nada y no se puede deshacer.
      allow update: if isDtOfTeam(resource.data.academyId, resource.data.teamId)
        && matchOpen(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status == 'CANCELADO'
        && request.resource.data.updatedAt == request.time;

      // US-008 (RN-010): el DT del equipo designa hasta 5 operadores, usuarios ACTIVOS de su academia,
      // mientras el partido no esté Finalizado ni Cancelado. Lecturas: perfil, equipo y hasta 5 usuarios (7 de 10).
      allow update: if isDtOfTeam(resource.data.academyId, resource.data.teamId)
        && !(resource.data.status in ['FINALIZADO', 'CANCELADO'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['operatorIds', 'updatedAt'])
        && validOperators(request.resource.data.operatorIds, resource.data.academyId)
        && request.resource.data.updatedAt == request.time;

      // US-008: el DT o un operador cambian SOLO el estado y el cronómetro (la app exige conexión para esto):
      //  - 'inicio': Programado/Convocado -> En curso (cronómetro corriendo desde 0), con el evento 'inicio'
      //    (startEventId) creado en el MISMO lote
      //  - pausar (solo si corría) / reanudar (solo si estaba en pausa) mientras está En curso
      //  - 'fin': En curso -> Finalizado (cronómetro detenido), con el evento 'fin' (endEventId) en el MISMO lote
      // Lecturas: perfil, equipo y el evento (3 de 10).
      allow update: if canRecord(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'clockRunning', 'clockRunningSince', 'clockElapsedMs', 'startedAt', 'finishedAt',
                       'startEventId', 'endEventId', 'updatedAt'])
        && validClock(request.resource.data)
        && request.resource.data.updatedAt == request.time
        && (
            // Pausar: corría y se detiene; lo acumulado crece a lo mucho el tiempo real transcurrido (+60 s de margen)
            (resource.data.status == 'EN_CURSO' && unchanged('status')
              && unchanged('startedAt') && unchanged('finishedAt')
              && unchanged('startEventId') && unchanged('endEventId')
              && resource.data.clockRunning == true && request.resource.data.clockRunning == false
              && stoppedElapsedOk())
            // Reanudar: estaba en pausa y vuelve a correr; lo acumulado no cambia
            || (resource.data.status == 'EN_CURSO' && unchanged('status')
              && unchanged('startedAt') && unchanged('finishedAt')
              && unchanged('startEventId') && unchanged('endEventId')
              && resource.data.clockRunning == false && request.resource.data.clockRunning == true
              && unchanged('clockElapsedMs'))
            // 'inicio'
            || (resource.data.status in ['PROGRAMADO', 'CONVOCADO']
              && request.resource.data.status == 'EN_CURSO'
              && request.resource.data.startedAt == request.time
              && request.resource.data.clockRunning == true
              && request.resource.data.clockElapsedMs == 0
              && unchanged('finishedAt') && unchanged('endEventId')
              && request.resource.data.startEventId is string
              && existsAfter(eventPath(matchId, request.resource.data.startEventId))
              && getAfter(eventPath(matchId, request.resource.data.startEventId)).data.typeId == 'inicio')
            // 'fin'
            || (resource.data.status == 'EN_CURSO'
              && request.resource.data.status == 'FINALIZADO'
              && request.resource.data.finishedAt == request.time
              && request.resource.data.clockRunning == false
              && stoppedElapsedOk()
              && unchanged('startedAt') && unchanged('startEventId')
              && request.resource.data.endEventId is string
              && existsAfter(eventPath(matchId, request.resource.data.endEventId))
              && getAfter(eventPath(matchId, request.resource.data.endEventId)).data.typeId == 'fin')
          );

      allow delete: if false;

      // US-008 / US-010: eventos del partido: matches/{matchId}/events/{eventId}
      // Los leen los miembros activos de la academia (listeners en tiempo real).
      // Los crean el DT del equipo o un operador. El ID es un UUID creado en el teléfono (RN-013).
      // Nunca se editan ni se borran por ahora (la US-009 abrirá la corrección con versiones).
      // Lecturas: partido (antes y después), perfil, equipo, tipo de evento y la observación (6 de 10).
      match /events/{eventId} {
        allow read: if isMemberOf(get(matchPath(matchId)).data.academyId);

        allow create: if canRecord(get(matchPath(matchId)).data)
          && eventId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
          && validEvent(request.resource.data,
               get(eventTypePath(get(matchPath(matchId)).data.academyId, request.resource.data.typeId)).data)
          && eventMomentOk(matchId, eventId, request.resource.data)
          // hasNote dice la verdad: la observación se crea en el MISMO lote
          && request.resource.data.hasNote == existsAfter(eventNotePath(matchId, eventId));

        allow update, delete: if false;
      }

      // US-008: observación de un evento, APARTE para que solo la lean el DT, los operadores y el ADM
      match /eventNotes/{eventId} {
        allow read: if canSeeNotes(get(matchPath(matchId)).data);

        // Se crea en el mismo lote que su evento, por la misma persona
        allow create: if canRecord(get(matchPath(matchId)).data)
          && request.resource.data.keys().hasOnly(['note', 'createdBy', 'createdAt'])
          && request.resource.data.note is string
          && request.resource.data.note.size() > 0 && request.resource.data.note.size() <= 140
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && !exists(eventPath(matchId, eventId))
          && existsAfter(eventPath(matchId, eventId))
          && getAfter(eventPath(matchId, eventId)).data.createdBy == request.auth.uid
          && getAfter(eventPath(matchId, eventId)).data.hasNote == true;

        allow update, delete: if false;
      }

      // Alineación: matches/{matchId}/lineup/current (RN-009). La leen los miembros de la academia.
      // Solo el DT del equipo la arma o cambia, con el partido abierto (antes del inicio),
      // con 1 titular como mínimo y sin pasar los máximos del equipo.
      // Cada titular lleva una posición de la lista. (Que sean convocados confirmados y que haya un
      // portero lo valida la app: las reglas no pueden recorrer la lista buscando.)
      match /lineup/{docId} {
        allow read: if docId == 'current' && isMemberOf(get(matchPath(matchId)).data.academyId);

        allow create, update: if docId == 'current'
          && isDtOfTeam(get(matchPath(matchId)).data.academyId, get(matchPath(matchId)).data.teamId)
          && matchOpen(get(matchPath(matchId)).data)
          && request.resource.data.keys().hasOnly(['starters', 'substitutes', 'updatedBy', 'updatedAt'])
          && request.resource.data.starters is list
          && request.resource.data.substitutes is list
          && request.resource.data.starters.size() >= 1
          && request.resource.data.starters.size() <= 11
          && validStarters(request.resource.data.starters)
          && request.resource.data.starters.size()
               <= get(teamPath(get(matchPath(matchId)).data.academyId, get(matchPath(matchId)).data.teamId)).data.maxStarters
          && request.resource.data.substitutes.size()
               <= get(teamPath(get(matchPath(matchId)).data.academyId, get(matchPath(matchId)).data.teamId)).data.maxSubstitutes
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;

        allow delete: if false;
      }

      // Convocados: matches/{matchId}/callups/{playerId}
      // Las copias (isMinor, playerUserId, guardianIds) deben coincidir con el jugador al convocarlo;
      // para responder se usa SIEMPRE el jugador real (isResponder).
      match /callups/{playerId} {
        // El DT del equipo y el ADM ven a todos los convocados
        allow list: if isDtOfTeam(get(matchPath(matchId)).data.academyId, get(matchPath(matchId)).data.teamId)
          || isAdmOf(get(matchPath(matchId)).data.academyId);
        // La familia lee la convocatoria de SU jugador (por ID; si no está convocado, no existe)
        allow get: if isDtOfTeam(get(matchPath(matchId)).data.academyId, get(matchPath(matchId)).data.teamId)
          || isAdmOf(get(matchPath(matchId)).data.academyId)
          || isFamily(get(playerPath(playerId)).data);

        // Convocar (el DT del equipo, con el partido abierto) a un jugador ACTIVO de ese equipo.
        // Lecturas: perfil, equipo y partido (compartidas) + el jugador. La app convoca de 8 en 8.
        allow create: if isDtOfTeam(get(matchPath(matchId)).data.academyId, get(matchPath(matchId)).data.teamId)
          && matchOpen(get(matchPath(matchId)).data)
          && request.resource.data.keys().hasOnly(['playerId', 'playerName', 'isMinor', 'playerUserId', 'guardianIds', 'response', 'createdAt'])
          && request.resource.data.playerId == playerId
          && get(playerPath(playerId)).data.academyId == get(matchPath(matchId)).data.academyId
          && get(playerPath(playerId)).data.teamId == get(matchPath(matchId)).data.teamId
          && get(playerPath(playerId)).data.active == true
          // PRIVACIDAD: nombre corto ("Mateo R.")
          && request.resource.data.playerName is string
          && request.resource.data.playerName.size() > 0 && request.resource.data.playerName.size() <= 30
          && request.resource.data.isMinor == get(playerPath(playerId)).data.isMinor
          && request.resource.data.playerUserId == get(playerPath(playerId)).data.userId
          && request.resource.data.guardianIds == get(playerPath(playerId)).data.guardianIds
          && request.resource.data.response == 'SIN_CONFIRMAR'
          && request.resource.data.createdAt == request.time;

        // Responder "Confirmo" o "No puedo": solo quien responde por ese jugador, dentro del plazo,
        // cambiando únicamente la respuesta y quién / cuándo respondió.
        allow update: if canRespond(matchId, playerId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['response', 'respondedBy', 'respondedByName', 'respondedAt'])
          && request.resource.data.response in ['CONFIRMADO', 'NO_PUEDE']
          && request.resource.data.respondedBy == request.auth.uid
          && request.resource.data.respondedByName is string && request.resource.data.respondedByName.size() <= 60
          && request.resource.data.respondedAt == request.time;

        allow delete: if false;
      }

      // Motivo de "No puedo", APARTE para que solo lo vea el DT: matches/{matchId}/callupReasons/{playerId}
      match /callupReasons/{playerId} {
        allow list: if isDtOfTeam(get(matchPath(matchId)).data.academyId, get(matchPath(matchId)).data.teamId);
        // Quien lo escribió también lo lee (si aún no existe, quien responde puede consultarlo)
        allow get: if isDtOfTeam(get(matchPath(matchId)).data.academyId, get(matchPath(matchId)).data.teamId)
          || (isResponder(get(playerPath(playerId)).data)
              && (resource == null || resource.data.writtenBy == request.auth.uid));

        // Lo escribe quien responde, en la MISMA operación que la respuesta (el convocado queda con
        // respondedAt == esta hora). Solo lleva texto si la respuesta es "No puede"; al confirmar queda vacío.
        allow create, update: if canRespond(matchId, playerId)
          && request.resource.data.keys().hasOnly(['reason', 'writtenBy', 'at'])
          && request.resource.data.reason is string && request.resource.data.reason.size() <= 140
          && request.resource.data.writtenBy == request.auth.uid
          && request.resource.data.at == request.time
          && existsAfter(callupPath(matchId, playerId))
          && getAfter(callupPath(matchId, playerId)).data.respondedAt == request.time
          && (request.resource.data.reason == ''
              || getAfter(callupPath(matchId, playerId)).data.response == 'NO_PUEDE');

        allow delete: if false;
      }
    }

    // ---------- US-008: funciones del registro del partido ----------

    function eventPath(matchId, eventId) {
      return /databases/$(database)/documents/matches/$(matchId)/events/$(eventId);
    }

    function eventNotePath(matchId, eventId) {
      return /databases/$(database)/documents/matches/$(matchId)/eventNotes/$(eventId);
    }

    function eventTypePath(academyId, typeId) {
      return /databases/$(database)/documents/academies/$(academyId)/eventTypes/$(typeId);
    }

    // Operador designado del partido, con su cuenta ACTIVA en la academia
    function isOperatorOf(m) {
      return isMemberOf(m.academyId) && request.auth.uid in m.get('operatorIds', []);
    }

    // Registra el partido: el DT del equipo o un operador (RN-010)
    function canRecord(m) {
      return isDtOfTeam(m.academyId, m.teamId) || isOperatorOf(m);
    }

    // Ven las observaciones: el DT del equipo, el ADM y los operadores
    function canSeeNotes(m) {
      return isDtOfTeam(m.academyId, m.teamId) || isAdmOf(m.academyId) || isOperatorOf(m);
    }

    // El operador número i (si existe) es un usuario ACTIVO de la academia.
    // Las reglas no tienen bucles: se revisa cada índice posible (máximo 5).
    function validOperatorAt(ops, i, academyId) {
      return ops.size() <= i
        || (ops[i] is string
            && get(userPath(ops[i])).data.academyId == academyId
            && get(userPath(ops[i])).data.status == 'active');
    }

    function validOperators(ops, academyId) {
      return ops is list && ops.size() <= 5
        && validOperatorAt(ops, 0, academyId) && validOperatorAt(ops, 1, academyId)
        && validOperatorAt(ops, 2, academyId) && validOperatorAt(ops, 3, academyId)
        && validOperatorAt(ops, 4, academyId);
    }

    // Cronómetro: corriendo desde la hora del servidor de ESTA escritura, o en pausa (sin hora).
    // Lo acumulado es un entero de milisegundos (hasta 24 horas; la app usa el mismo límite).
    function validClock(data) {
      return data.clockRunning is bool
        && data.clockElapsedMs is int && data.clockElapsedMs >= 0 && data.clockElapsedMs <= 86400000
        && ((data.clockRunning == true && data.clockRunningSince == request.time)
            || (data.clockRunning == false && data.clockRunningSince == null));
    }

    // Al detener el cronómetro (pausar o 'fin'): si corría, lo acumulado no baja y crece a lo mucho el tiempo
    // real desde clockRunningSince, con 60 s de margen (los relojes de los emuladores se desfasan);
    // si ya estaba en pausa, no cambia.
    function stoppedElapsedOk() {
      return (resource.data.clockRunning == true
              && request.resource.data.clockElapsedMs >= resource.data.clockElapsedMs
              && request.resource.data.clockElapsedMs <= resource.data.clockElapsedMs
                   + (request.time.toMillis() - resource.data.clockRunningSince.toMillis()) + 60000)
        || (resource.data.clockRunning == false
              && request.resource.data.clockElapsedMs == resource.data.clockElapsedMs);
    }

    // Evento válido. type = el tipo del catálogo de la academia (debe existir).
    // Se copian nombre, ícono, color y "afecta el marcador" (RN-011); este último debe ser el del catálogo.
    function validEvent(data, type) {
      return data.keys().hasOnly(['typeId', 'typeName', 'typeIcon', 'typeColor', 'affectsScore', 'minute', 'side',
                                  'playerId', 'playerName', 'rivalNumber', 'playerOutId', 'playerOutName', 'hasNote',
                                  'pendingIdentification', 'late', 'postInsert', 'status', 'version',
                                  'createdBy', 'createdByName', 'createdAt', 'clientCreatedAt'])
        && data.typeName is string && data.typeName.size() > 0 && data.typeName.size() <= 30
        && data.typeIcon in ['balon', 'inicio', 'fin', 'tarjeta', 'cambio', 'silbato', 'penal', 'prohibido',
                             'banderin', 'mano', 'escudo', 'reloj', 'advertencia', 'estrella']
        && data.typeColor in ['#0E6B6F', '#2E7D32', '#1565C0', '#F2B705', '#C2410C', '#6A4C93', '#5F6B6D', '#E8710A']
        && data.affectsScore == type.affectsScore
        && data.minute is int && data.minute >= 1 && data.minute <= 130
        // Equipo: solo si el tipo lo pide
        && ((type.requiresTeam == true && data.side in ['LOCAL', 'RIVAL'])
            || (type.requiresTeam == false && data.side == ''))
        // Jugador nuestro (nombre corto) solo si es de nuestro equipo; dorsal solo si es del rival
        && data.playerId is string && data.playerName is string && data.playerName.size() <= 30
        && (data.playerId == '') == (data.playerName == '')
        && data.playerOutId is string && data.playerOutName is string && data.playerOutName.size() <= 30
        && (data.playerOutId == '') == (data.playerOutName == '')
        && (data.playerOutId == '' || data.typeId == 'cambio')
        && (data.side == 'LOCAL' || (data.playerId == '' && data.playerOutId == ''))
        && (data.rivalNumber == null
            || (data.side == 'RIVAL' && data.rivalNumber is int && data.rivalNumber >= 1 && data.rivalNumber <= 99))
        && data.hasNote is bool && data.pendingIdentification is bool
        && data.late is bool && data.postInsert is bool
        && data.status == 'VIGENTE'
        && data.version == 1
        && data.createdBy == request.auth.uid
        // el nombre de quien registra es el de su perfil real
        && data.createdByName == myProfile().name
        && data.createdAt == request.time
        && data.clientCreatedAt is timestamp;
    }

    // Momento del partido en que se registra el evento:
    //  - 'inicio': el partido estaba Programado/Convocado y queda En curso en esta misma escritura, con este evento
    //    como startEventId
    //  - 'fin': estaba En curso y queda Finalizado en esta misma escritura, con este evento como endEventId
    //  - los demás: con el partido En curso; después del 'fin', como "Inserción posterior", o SIN inserción
    //    posterior si se registró sin conexión ANTES del 'fin' y llegó después (su hora del teléfono es anterior
    //    o igual a finishedAt y no está en el futuro)
    function eventMomentOk(matchId, eventId, data) {
      let before = get(matchPath(matchId)).data;
      let after = getAfter(matchPath(matchId)).data;
      return (data.typeId == 'inicio' && data.postInsert == false
              && before.status in ['PROGRAMADO', 'CONVOCADO'] && after.status == 'EN_CURSO'
              && after.get('startEventId', '') == eventId)
        || (data.typeId == 'fin' && data.postInsert == false
              && before.status == 'EN_CURSO' && after.status == 'FINALIZADO'
              && after.get('endEventId', '') == eventId)
        || (!(data.typeId in ['inicio', 'fin'])
              && ((before.status == 'EN_CURSO' && data.postInsert == false)
                  || (before.status == 'FINALIZADO' && data.postInsert == true)
                  || (before.status == 'FINALIZADO' && data.postInsert == false
                      && data.clientCreatedAt <= before.finishedAt
                      && data.clientCreatedAt <= request.time)));
    }

    // ---------- Base de la US-012: notificaciones dentro de la app (US-006) ----------
    // La escribe la app de quien hace la acción, una por destinatario (plan gratuito: sin Cloud Functions).
    // PRIVACIDAD: textos cortos sin datos sensibles (la app solo pone equipo, rival y fecha del partido).
    match /notifications/{notificationId} {
      // Cada persona lista solo las suyas (consulta con where recipientUid == su uid)
      allow list: if signedIn() && resource.data.recipientUid == request.auth.uid;
      // Una notificación la lee su destinatario. Quien la crea puede consultar si ya existe
      // (resource == null) o leer la que él escribió: así un reintento salta las que ya se enviaron.
      allow get: if signedIn()
        && (resource == null
            || resource.data.recipientUid == request.auth.uid
            || resource.data.createdBy == request.auth.uid);

      // Campos y textos válidos (cortos y sin datos sensibles) y el partido es de la MISMA academia
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['recipientUid', 'academyId', 'type', 'title', 'body', 'matchId', 'playerId', 'read', 'createdBy', 'createdAt'])
        && validNoticeFields(request.resource.data)
        && get(matchPath(request.resource.data.matchId)).data.academyId == request.resource.data.academyId
        && validNoticeId(notificationId, request.resource.data)
        && (dtMatchNotice(request.resource.data) || responseNotice(request.resource.data));

      // Solo su destinatario la marca como leída (y solo eso)
      allow update: if signedIn()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;

      allow delete: if false;
    }

    // ---------- Notificaciones: funciones ----------

    function validNoticeFields(data) {
      return data.recipientUid is string && data.recipientUid != '' && data.recipientUid != request.auth.uid
        && data.academyId is string
        && data.type in ['CONVOCATORIA', 'RESPUESTA', 'PARTIDO_REPROGRAMADO', 'PARTIDO_CANCELADO']
        && data.title is string && data.title.size() > 0 && data.title.size() <= 80
        && data.body is string && data.body.size() <= 160
        && data.matchId is string && data.matchId.size() > 0 && data.matchId.size() <= 40
        && data.playerId is string && data.playerId.size() > 0
        && data.read == false
        && data.createdBy == request.auth.uid
        && data.createdAt == request.time;
    }

    // ID fijo {tipo}_{matchId}_{uid} (un reintento no duplica). La reprogramación y la respuesta
    // llevan además la marca de tiempo del cambio: _{milisegundos}.
    function validNoticeId(notificationId, data) {
      return (data.type in ['CONVOCATORIA', 'PARTIDO_CANCELADO']
              && notificationId == data.type + '_' + data.matchId + '_' + data.recipientUid)
        || (data.type in ['PARTIDO_REPROGRAMADO', 'RESPUESTA']
              && notificationId.matches('^' + data.type + '_' + data.matchId + '_' + data.recipientUid + '_[0-9]+$'));
    }

    // Convocatoria, reprogramación y cancelación: solo el DT del equipo del partido, y el destinatario
    // es el jugador mayor (playerUserId) o un apoderado de ESE convocado.
    // Lecturas: mi perfil, el equipo y el partido (compartidas en el lote) + el convocado.
    function dtMatchNotice(data) {
      let m = get(matchPath(data.matchId)).data;
      let c = get(callupPath(data.matchId, data.playerId)).data;
      return data.type in ['CONVOCATORIA', 'PARTIDO_REPROGRAMADO', 'PARTIDO_CANCELADO']
        && isDtOfTeam(m.academyId, m.teamId)
        && ((c.playerUserId != '' && data.recipientUid == c.playerUserId)
            || data.recipientUid in c.guardianIds);
    }

    // Nueva respuesta: la crea quien puede responder por ese convocado, solo para el DT que creó el
    // partido, y ese DT sigue activo y a cargo del equipo. Lecturas: perfil, partido, academia, jugador y el DT.
    function responseNotice(data) {
      let m = get(matchPath(data.matchId)).data;
      let dt = get(userPath(data.recipientUid)).data;
      return data.type == 'RESPUESTA'
        && canRespond(data.matchId, data.playerId)
        && data.recipientUid == m.createdBy
        && dt.role == 'DT' && dt.status == 'active' && dt.teamId == m.teamId
        && dt.academyId == m.academyId;
    }

    // Todo lo demás queda cerrado hasta que lo abra su historia de usuario.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
